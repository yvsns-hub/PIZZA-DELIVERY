# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizza_delivery?retryWrites=true&w=majority"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="your_jwt_secret_here"

# SMTP Settings for Gmail notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="PIZZA DELIVERY <your-email@gmail.com>"

# Razorpay Test Keys
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
